#!/usr/bin/env bash
# Record every push, so an agent working in the sandbox can READ what left this
# machine instead of inferring it.
#
# Why this exists: the agent cannot push (no ssh in the container) and cannot
# fetch, so it has repeatedly reported "N unpushed commits" from a snapshot
# taken minutes earlier and then restated it as if still true. `origin/main`
# does track correctly when you push from this working copy -- but that is an
# assumption which breaks the moment a push happens from another clone, and it
# carries no timestamp. This log is the ground truth for "what was pushed, and
# when", and .githooks/push-status reads it.
#
# NEVER blocks a push: a logging failure must not cost you a push.
set -uo pipefail

remote_name="${1:-?}"
remote_url="${2:-?}"
log="$(git rev-parse --git-dir 2>/dev/null)/push-log.tsv" || exit 0
ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

{
  [ -s "$log" ] || printf 'timestamp\tremote\turl\tref\tlocal_sha\tremote_sha_before\n' > "$log"
  while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$ts" "$remote_name" "$remote_url" "${remote_ref:-?}" "${local_sha:-?}" "${remote_sha:-?}" >> "$log"
  done
} 2>/dev/null

exit 0
