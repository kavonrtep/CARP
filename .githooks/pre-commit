#!/usr/bin/env python3
"""
Pre-commit hook: enforce Singularity %files coverage for new runtime files.

The CARP pipeline ships as a Singularity container. Files the pipeline reads
at runtime MUST be listed in the %files section of the Singularity definition,
otherwise the container builds cleanly but fails at run time — as happened
with classification_vocabulary.yaml in April 2026.

This hook runs on every `git commit`. It fails the commit if any newly-added
file looks like a runtime artifact but is not covered by %files.

It also refuses oversized blobs. In September 2026 a single `git add -f` on a
scratch directory swept ~1.4 GB of intermediate FASTAs and alignment tables into
the repo (176 MB over the wire, ten GitHub large-file warnings), and undoing it
needed a history rewrite and a force-push. Blobs are forever; a commit is cheap
to redo.

  * Install once per checkout:   git config core.hooksPath .githooks
  * Bypass when you're sure:     git commit --no-verify   (not recommended)
  * Exempt a dev-only path:      add a pattern to EXCLUDE_PATTERNS below.
"""
from __future__ import annotations

import fnmatch
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# Glob patterns (relative to repo root) that are known dev-only — docs,
# tests, IDE config, CI config, generated artefacts. Everything else is
# considered potentially runtime-relevant and must be covered by %files
# (or explicitly added here if it's dev-only).
EXCLUDE_PATTERNS = [
    # documentation and plans
    "*.md",
    "*_PLAN.md", "*_AUDIT.md",
    "annotation_rules.md",
    "README.md", "CLAUDE.md", "AGENTS.md",
    # test harness
    "tests/*", "tests/**/*",
    # VCS / CI / hook / editor config
    ".gitignore", ".gitattributes",
    ".github/*", ".github/**/*",
    ".githooks/*",
    ".claude/*", ".claude/**/*",
    ".codex*",
    ".idea/*", ".idea/**/*",
    ".pre-commit-config.yaml",
    # generated / scratch
    ".snakemake/*", ".snakemake/**/*",
    "output/*", "output/**/*",
    "tmp/*", "tmp/**/*",
    "hermit/*", "hermit/**/*",
    # figures, images, wublast legacy dir
    "figs/*", "figs/**/*",
    "images/*", "images/**/*",
    "wublast/*", "wublast/**/*",
    "*.svg", "*.png", "*.pdf", "*.odg",
    # build entry / env setup — not runtime
    "Makefile",
    "setup.sh", "bootstrap.sh",
]


def is_excluded(path: str) -> bool:
    return any(fnmatch.fnmatch(path, pat) for pat in EXCLUDE_PATTERNS)


def parse_singularity_files(text: str) -> list[tuple[str, str]]:
    """Return [(source, dest), ...] entries from the %files section."""
    entries: list[tuple[str, str]] = []
    in_files = False
    for line in text.splitlines():
        if re.match(r"^%files\b", line):
            in_files = True
            continue
        if in_files and line.startswith("%"):
            break
        if not in_files:
            continue
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        parts = stripped.split()
        if len(parts) >= 2:
            entries.append((parts[0], parts[1]))
    return entries


def is_covered(path: str, sources: list[str]) -> bool:
    for src in sources:
        if src == path or path.startswith(src + "/"):
            return True
    return False


def git(*args: str) -> str:
    return subprocess.check_output(["git", *args], cwd=REPO, text=True)


def check_files_coverage() -> int:
    added = [p for p in git("diff", "--cached", "--diff-filter=A",
                             "--name-only").splitlines() if p]
    if not added:
        return 0

    sing_path = REPO / "Singularity"
    if not sing_path.exists():
        return 0

    sources = [src for src, _ in parse_singularity_files(sing_path.read_text())]

    violations = [
        p for p in added
        if not is_excluded(p) and not is_covered(p, sources)
    ]
    if not violations:
        return 0

    singularity_staged = "Singularity" in git(
        "diff", "--cached", "--name-only"
    ).splitlines()

    if singularity_staged:
        # User is actively editing Singularity; trust them and just report.
        print("[pre-commit] Singularity is staged — verify these files are "
              "listed in its %files section:", file=sys.stderr)
        for v in violations:
            print(f"  {v}", file=sys.stderr)
        return 0

    print("", file=sys.stderr)
    print("pre-commit: Singularity %files not updated", file=sys.stderr)
    print("-" * 65, file=sys.stderr)
    print("", file=sys.stderr)
    print("These newly-added files are NOT covered by the Singularity %files", file=sys.stderr)
    print("section. If the pipeline reads them at run time, the container will", file=sys.stderr)
    print("build cleanly but fail at run time:", file=sys.stderr)
    print("", file=sys.stderr)
    for v in violations:
        print(f"  * {v}", file=sys.stderr)
        print(f"      suggested line:  {v} /opt/pipeline/{v}", file=sys.stderr)
    print("", file=sys.stderr)
    print("Options:", file=sys.stderr)
    print("  1. Add the file(s) to %files in Singularity, stage the change,", file=sys.stderr)
    print("     and commit again.", file=sys.stderr)
    print("  2. If the file is dev-only (not read at run time), add its", file=sys.stderr)
    print("     path/glob to EXCLUDE_PATTERNS in .githooks/pre-commit.", file=sys.stderr)
    print("  3. Bypass: `git commit --no-verify`  (use sparingly).", file=sys.stderr)
    print("", file=sys.stderr)
    return 1


def check_runner_deps() -> int:
    """Run the CI runner-deps guard when a workflow or test file is staged, so a
    test wired into a job whose env lacks its dependency is caught at commit time
    (not just as a red CI job). Non-fatal if the guard itself cannot run locally
    (e.g. pyyaml missing) — CI enforces it regardless."""
    staged = [p for p in git("diff", "--cached", "--name-only").splitlines() if p]
    if not any(p.startswith(".github/workflows/") or p.startswith("tests/test_")
               for p in staged):
        return 0
    guard = REPO / "tests" / "test_ci_runner_deps.py"
    if not guard.exists():
        return 0
    proc = subprocess.run([sys.executable, str(guard)], cwd=REPO,
                          capture_output=True, text=True)
    if proc.returncode == 0:
        return 0
    if "FAIL:" in proc.stdout:
        print("", file=sys.stderr)
        print("pre-commit: a test is wired to a CI job that lacks its dependency",
              file=sys.stderr)
        print("-" * 65, file=sys.stderr)
        sys.stderr.write(proc.stdout)
        print("Fix the workflow (move the test / add the package), or bypass with",
              file=sys.stderr)
        print("`git commit --no-verify` (use sparingly).", file=sys.stderr)
        return 1
    # Guard could not run (missing pyyaml, etc.) — don't block; CI still checks.
    print("[pre-commit] runner-deps guard skipped (could not run locally); "
          "CI will still check.", file=sys.stderr)
    return 0


# --- size guard ---------------------------------------------------------
# Largest legitimately tracked file is ~1 MB (tests/fixtures/genome_small.fasta),
# so 5 MB leaves generous headroom while still catching the 55-100 MB analysis
# outputs that caused the September 2026 incident. GitHub warns at 50 MB and
# rejects at 100 MB, so this is deliberately far stricter than the point of
# no return -- the aim is to stop it at commit time, not at push time.
MAX_FILE_BYTES = 5 * 1024 * 1024
# A per-file cap alone does not stop death by a thousand 4 MB files, so the
# whole staged set is bounded too.
MAX_TOTAL_BYTES = 20 * 1024 * 1024
# Paths allowed to exceed the per-file cap. Keep this list short and justified;
# an entry here is a permanent addition to every clone.
SIZE_ALLOWLIST = (
    "tests/fixtures/*",
)


def _human(n: int) -> str:
    return f"{n / 1048576:.1f} MB" if n >= 1048576 else f"{n / 1024:.0f} KB"


def check_sizes() -> int:
    """Refuse oversized staged blobs, per file and in total.

    Sizes come from the staged INDEX (git cat-file on the blob), not the working
    tree, so what is measured is exactly what would enter history.
    """
    out = git("diff", "--cached", "--name-only", "--diff-filter=ACM")
    staged = [p for p in out.splitlines() if p]
    if not staged:
        return 0

    oversized: list[tuple[str, int]] = []
    total = 0
    for path in staged:
        raw = subprocess.run(["git", "cat-file", "-s", f":{path}"], cwd=REPO,
                             capture_output=True, text=True)
        if raw.returncode != 0:
            continue                      # deleted / unreadable: nothing to weigh
        size = int(raw.stdout.strip() or 0)
        total += size
        if size > MAX_FILE_BYTES and not any(
                fnmatch.fnmatch(path, pat) for pat in SIZE_ALLOWLIST):
            oversized.append((path, size))

    if not oversized and total <= MAX_TOTAL_BYTES:
        return 0

    print("", file=sys.stderr)
    print("pre-commit: refusing to commit oversized files", file=sys.stderr)
    print("-" * 65, file=sys.stderr)
    if oversized:
        print(f"{len(oversized)} file(s) over {_human(MAX_FILE_BYTES)}:", file=sys.stderr)
        for path, size in sorted(oversized, key=lambda x: -x[1])[:10]:
            print(f"  {_human(size):>10}  {path}", file=sys.stderr)
        if len(oversized) > 10:
            print(f"  ... and {len(oversized) - 10} more", file=sys.stderr)
    if total > MAX_TOTAL_BYTES:
        print(f"staged total {_human(total)} exceeds the "
              f"{_human(MAX_TOTAL_BYTES)} limit ({len(staged)} files)", file=sys.stderr)
    print("", file=sys.stderr)
    print("Git blobs are permanent: removing them later needs a history rewrite", file=sys.stderr)
    print("and a force-push. Options:", file=sys.stderr)
    print("  * unstage the data      git restore --staged <paths>", file=sys.stderr)
    print("  * ignore it             add a pattern to .gitignore", file=sys.stderr)
    print("  * it genuinely belongs  add it to SIZE_ALLOWLIST in this hook", file=sys.stderr)
    print("  * override just once    git commit --no-verify", file=sys.stderr)
    return 1


def main() -> int:
    return max(check_sizes(), check_files_coverage(), check_runner_deps())


if __name__ == "__main__":
    sys.exit(main())
